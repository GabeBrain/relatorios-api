{
  "name": "slide-maker-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretest": "node scripts/sync-bridge.mjs --check",
    "prebuild": "node scripts/sync-bridge.mjs --check",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "sync-shared": "node scripts/sync-shared.mjs",
    "test:lib": "python -m unittest discover -s lib/testes -t lib/testes"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@google-cloud/tasks": "^7.3.1",
    "@supabase/supabase-js": "^2.119.0",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.4",
    "jszip": "3.10.2",
    "pptxgenjs": "4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^22.20.5",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  }
}
